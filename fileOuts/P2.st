Announcement subclass: #LudoDieRolled	instanceVariableNames: ''	classVariableNames: ''	package: 'P2-Model'!Object subclass: #LudoDie	instanceVariableNames: 'topFace announcer'	classVariableNames: ''	package: 'P2-Model'!!LudoDie methodsFor: 'accessing' stamp: '5/6/2026 11:39'!topFace	^ topFace! !!LudoDie methodsFor: 'accessing' stamp: '5/6/2026 12:04'!announcer	^ announcer! !!LudoDie methodsFor: 'initialization' stamp: '5/6/2026 12:04'!initialize	announcer := Announcer new.	self roll! !!LudoDie methodsFor: 'updating' stamp: '5/6/2026 12:09'!roll: anInteger	self assert: anInteger isNumber.	self assert: anInteger >= 1.	self assert: anInteger <= 6.	topFace := anInteger.	self notifyRolled.	^ topFace! !!LudoDie methodsFor: 'updating' stamp: '5/6/2026 12:09'!roll	topFace := (1 to: 6) atRandom.	self notifyRolled.	^ topFace! !!LudoDie methodsFor: 'views' stamp: '5/6/2026 11:56'!gtRollFor: anAction	<gtAction>	^ anAction button		icon: BrGlamorousVectorIcons play;		tooltip: 'Roll the die';		action: [ :button | self roll ]! !!LudoDie methodsFor: 'views' stamp: '5/6/2026 12:10'!gtTopFaceFor: aView	<gtView>	^ aView forward		title: 'TopFace preview';		object: [ topFace ];		view: #gtPreviewFor:;		actionUpdateButton;		updateWhen: LudoDieRolled in: self announcer! !!LudoDie methodsFor: 'announcements' stamp: '5/6/2026 12:06'!notifyRolled	^ self announcer announce: LudoDieRolled new! !Object subclass: #LudoDieExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'P2-Examples'!!LudoDieExamples methodsFor: 'accessing' stamp: '5/6/2026 11:43'!freshDie	<gtExample>	| die |	die := LudoDie new.	self assert: die topFace isNumber.	self assert: die topFace >= 1.	self assert: die topFace <= 6.	^ die! !!LudoDieExamples methodsFor: 'accessing' stamp: '5/6/2026 11:48'!roll6	<gtExample>	| die |	die := self freshDie.	die roll: 6.	self assert: die topFace equals: 6.	^ die! !!LudoDieExamples methodsFor: 'accessing' stamp: '5/6/2026 11:52'!randomRoll	<gtExample>	| die |	die := self freshDie.	die roll.	self assert: die topFace isNumber.	self assert: die topFace >= 1.	self assert: die topFace <= 6.	^ die! !