							"uid" : {
								"__type" : "uid",
								"uidString" : "28x3BcvQQnieIdVdJVV+TQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "• GenAI has driven down the cost of producing a visualization toward zero.\n• The cost for humans of interpreting visualizations remains high — *“AI facilitates visualization, but seeing remains a human act.”*\n• Future research should  focus on helping humans interpret and trust AI-generated visualizations."
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
